# Application Settings
APP_ENV=development
BASE_URL=http://localhost:8000
ADMIN_TOKEN=dev-secret-admin-token-min-32-chars-long-abc-123
ALLOW_DEMO_RESET=true

# Database
DB_PATH=allowance.db

# Anthropic Claude API
ANTHROPIC_API_KEY=mock-key-for-offline-dev
CLAUDE_MODEL=claude-3-5-sonnet-20241022
AGENT_MODE=live
DAILY_CLAUDE_CAP=300

# PayPal Integration
PAYPAL_MODE=mock
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=mock-client-id
PAYPAL_CLIENT_SECRET=mock-client-secret
PAYPAL_MERCHANT_ID=MOCKMERCHANT123
PAYPAL_BUSINESS_EMAIL=business-sandbox@allowance.dev

# Operational Limits
RATE_LIMIT_AGENT_RUN=10
RATE_LIMIT_PREVIEW=6
GLOBAL_RUNS_PER_HOUR=60
MAX_PENDING_CARTS=3
MAX_ACTIVE_RESERVATIONS=5
MAX_USER_MESSAGE_CHARS=500
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]

