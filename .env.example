# ==============================================================================
# ALLOWANCE (v5.0) — Environment Configuration Template
# Copy this file to .env to customize local or sandbox execution.
#
# By default, Allowance runs in ZERO-CONFIGURATION mode:
# - PAYPAL_MODE=mock (deterministic in-memory Orders v2 mock)
# - No ANTHROPIC_API_KEY required (deterministic ShopMind fallback agent runs)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Integration Mode
# Options: "mock" (default, zero keys required) or "sandbox"
# ------------------------------------------------------------------------------
PAYPAL_MODE=mock

# Required ONLY if PAYPAL_MODE=sandbox
# Get sandbox credentials at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: Specific Sandbox Merchant Payee Email for testing multi-merchant routing
PAYPAL_SANDBOX_PAYEE=
PAYPAL_MERCHANT_SHOES_PAYEE=
PAYPAL_MERCHANT_COFFEE_PAYEE=
PAYPAL_MERCHANT_TECH_PAYEE=

# ------------------------------------------------------------------------------
# 2. AI Model Provider (ShopMind)
# If omitted or empty, ShopMind runs in deterministic fallback mode (works offline).
# If provided, ShopMind uses Claude 3.5 Sonnet to parse natural language requests.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. Security Tokens & Administrative Credentials
# ------------------------------------------------------------------------------
# Token for emergency kill switch toggle (/api/freeze) and supervisor approvals
ADMIN_TOKEN=dev-secret-admin-token-min-32-chars-long-abc-123

# Session token for dashboard UI communication
DEMO_SESSION_TOKEN=demo-session-token-allowance-hackathon-2026

# Allows one-click demo database resets (/api/demo/reset)
ALLOW_DEMO_RESET=true

# ------------------------------------------------------------------------------
# 4. Server & Storage Settings
# ------------------------------------------------------------------------------
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=allowance.db
BUSY_TIMEOUT_MS=5000
