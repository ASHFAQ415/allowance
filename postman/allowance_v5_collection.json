{
  "info": {
    "_postman_id": "f8a12903-b82d-482a-9cb0-allowance-v5",
    "name": "ALLOWANCE v5.0 — Autonomous Financial Authorization API",
    "description": "Postman Collection for Allowance v5.0 — The autonomous AI spending control, policy engine, and double-entry financial authorization platform built on PayPal Orders v2 for the PayPal AI Hackathon 2026.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
